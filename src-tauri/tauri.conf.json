{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tactile Reader",
  "version": "0.1.0",
  "identifier": "com.jrmello4.tactilereader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tactile Reader",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
