{
  "name": "tactile-reader",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test tests/visual --config playwright.config.ts",
    "test:release-scripts": "node --test scripts/release/check-version.test.mjs scripts/android/make-latest-json.test.mjs",
    "test:performance-contract": "node --test scripts/performance/performance-contract.test.mjs scripts/performance/performance-fixtures.test.mjs scripts/performance/performance-navigation.test.mjs",
    "performance:compare": "node scripts/performance/compare-performance.mjs",
    "test:workflow": "node scripts/release/verify-workflow.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "test:performance-idle": "playwright test --config playwright.perf.config.ts",
    "test:scale-sweep": "cargo test --release --manifest-path src-tauri/Cargo.toml scale_sweep -- --ignored --nocapture",
    "test:android-zoom": "node scripts/performance/verify-android-zoom.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
